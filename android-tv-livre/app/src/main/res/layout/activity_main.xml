<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Inline video player for TV AO VIVO -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/inlinePlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <!-- Hero background (poster/logo for non-playing state) -->
    <ImageView
        android:id="@+id/heroBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.6"/>

    <!-- Gradient overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_overlay"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: logo + tabs + clock -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="#CC0B0F1A">

            <!-- Logo Amaro TV -->
            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:src="@drawable/logo_amaro_tv"
                android:scaleType="fitCenter"
                android:focusable="false"
                android:contentDescription="Amaro TV"/>

            <!-- Search icon -->
            <ImageView
                android:id="@+id/searchIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:src="@android:drawable/ic_menu_search"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:contentDescription="Buscar"/>

            <!-- Tabs -->
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none"
                android:layout_marginStart="16dp">

                <LinearLayout
                    android:id="@+id/tabsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"/>
            </HorizontalScrollView>

            <!-- Gear -->
            <ImageView
                android:id="@+id/gearIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_gear"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:contentDescription="Configurações"/>

            <!-- Clock -->
            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/tab_text"
                android:textSize="18sp"/>

            <!-- Botão SAIR → volta ao S.O. original -->
            <TextView
                android:id="@+id/exitBtn"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="SAIR"
                android:textColor="#FF4444"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/tab_background"
                android:focusable="true"
                android:focusableInTouchMode="true"/>
        </LinearLayout>

        <!-- Main content area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Hero info (for non-live tabs: title + desc + poster grid) -->
            <LinearLayout
                android:id="@+id/heroInfo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="bottom"
                android:paddingStart="48dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:maxLines="2"/>

                <TextView
                    android:id="@+id/heroDesc"
                    android:layout_width="600dp"
                    android:layout_height="wrap_content"
                    android:textColor="#CCFFFFFF"
                    android:textSize="16sp"
                    android:maxLines="3"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- TV AO VIVO: buttons + info bar at bottom -->
            <LinearLayout
                android:id="@+id/liveInfoBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Buttons row — above the info bar, aligned left -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="48dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/btnFullscreen"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="MODO TELA CHEIA"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/tab_background"
                        android:focusable="true"
                        android:focusableInTouchMode="true"/>

                    <TextView
                        android:id="@+id/btnChannelGrid"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginStart="12dp"
                        android:text="VER GRADE DE CANAIS"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/tab_background"
                        android:focusable="true"
                        android:focusableInTouchMode="true"/>
                </LinearLayout>

                <!-- Transparent info band -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#99000020"
                    android:paddingStart="48dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:paddingEnd="24dp">

                    <TextView
                        android:id="@+id/liveChannelName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/liveChannelDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Channel grid overlay (pink gradient list) -->
            <LinearLayout
                android:id="@+id/channelGridOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:background="#DD1A0030"
                android:visibility="gone">

                <!-- Left: channel list -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="48dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TV AO VIVO"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <!-- Category tabs -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:id="@+id/gridCategoryTabs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"/>
                    </HorizontalScrollView>

                    <!-- Channel list -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/channelListView"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/channelCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#AAFFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Right: live preview area -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingTop="16dp"
                    android:paddingEnd="32dp"
                    android:paddingBottom="16dp"
                    android:paddingStart="16dp">

                    <androidx.media3.ui.PlayerView
                        android:id="@+id/gridPreviewPlayer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:background="#99000000"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/gridPreviewName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/gridPreviewDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Category title -->
        <TextView
            android:id="@+id/categoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="48dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:visibility="gone"/>

        <!-- Content area for non-live tabs (poster rows) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/contentGrid"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:clipToPadding="false"
            android:paddingStart="48dp"/>

        <!-- Category navigation arrow -->
        <TextView
            android:id="@+id/categoryArrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#AAFFFFFF"
            android:textSize="22sp"
            android:fontFamily="sans-serif"
            android:paddingBottom="8dp"
            android:visibility="gone"/>
    </LinearLayout>
</FrameLayout>
