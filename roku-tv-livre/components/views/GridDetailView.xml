<?xml version="1.0" encoding="utf-8"?>
<!-- Series screen: poster + preview (~70% of the height), season combobox and
     Minha Lista button, episode row at the bottom. -->
<component name="GridDetailView" extends="BaseView">
  <interface>
    <field id="item" type="assocarray" onChange="onItem"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/components/utils.brs"/>
  <script type="text/brightscript" uri="pkg:/components/views/GridDetailView.brs"/>
  <script type="text/brightscript" uri="pkg:/components/views/PlayerSubtitleHelper.brs"/>
  <children>
    <Rectangle width="1920" height="1080" color="0x0B0F1AFF"/>
    <!-- Holds focus for back/preview/combo/fav: focusing this view itself is ignored
         while the episode row (a descendant) has focus. Keys bubble up to the view. -->
    <Group id="keySink" focusable="true"/>

    <!-- Top bar -->
    <Rectangle translation="[0,0]" width="1920" height="80" color="0x101626FF"/>
    <Label id="backLabel" text="← Voltar" translation="[40,20]" color="0x9AA4B2FF">
      <Font role="font" uri="font:BoldSystemFontFile" size="30"/>
    </Label>
    <Label id="headerTitle" translation="[200,20]" width="1100" color="0xFFFFFFFF">
      <Font role="font" uri="font:BoldSystemFontFile" size="30"/>
    </Label>
    <Label id="fullscreenHint" text="OK = Tela cheia" translation="[1340,24]" width="500" horizAlign="right" color="0x9AA4B2FF" visible="false">
      <Font role="font" uri="font:SystemFontFile" size="24"/>
    </Label>

    <!-- Poster: the whole image always fits inside the card. -->
    <Rectangle id="posterBg" translation="[80,100]" width="500" height="740" color="0x1C2333FF"/>
    <Poster id="poster" translation="[80,100]" width="500" height="740" loadDisplayMode="scaleToFit"
        loadingBitmapUri="pkg:/images/placeholder.png" failedBitmapUri="pkg:/images/placeholder.png"/>

    <!-- Preview -->
    <Rectangle id="previewRing" translation="[604,94]" width="1242" height="752" color="0x9B5DE5FF" opacity="0"/>
    <Rectangle id="previewBg" translation="[610,100]" width="1230" height="740" color="0x1C2333FF"/>
    <Video id="video" translation="[610,100]" width="1230" height="740" enableUI="false"/>
    <Label id="videoStatus" translation="[610,450]" width="1230" horizAlign="center" color="0x9AA4B2FF">
      <Font role="font" uri="font:SystemFontFile" size="28"/>
    </Label>
    <!-- Remote keys and progress bar while in full screen. -->
    <PlayerControls id="controls"/>
    <!-- End of an episode in full screen: countdown to the next one. -->
    <Group id="nextBox" visible="false">
      <Rectangle translation="[1240,800]" width="620" height="200" color="0x000000FF" opacity="0.85"/>
      <Rectangle translation="[1240,800]" width="8" height="200" color="0x9B5DE5FF"/>
      <Label id="nextTitle" translation="[1280,826]" width="560" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="34"/>
      </Label>
      <Label id="nextCount" translation="[1280,878]" width="560" color="0xDDE3EAFF">
        <Font role="font" uri="font:SystemFontFile" size="30"/>
      </Label>
      <Label text="OK assiste agora   |   Voltar cancela" translation="[1280,940]" width="560" color="0x9AA4B2FF">
        <Font role="font" uri="font:SystemFontFile" size="24"/>
      </Label>
    </Group>
    <Timer id="nextTimer" duration="1" repeat="true"/>

    <!-- Season combobox -->
    <Group id="row2">
      <Rectangle id="comboRing" translation="[76,862]" width="388" height="72" color="0x9B5DE5FF" opacity="0"/>
      <Rectangle translation="[80,866]" width="380" height="64" color="0x1C2333FF"/>
      <Label id="comboText" translation="[104,866]" width="290" height="64" vertAlign="center" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="28"/>
      </Label>
      <Poster uri="pkg:/images/arrow_down.png" translation="[408,880]" width="36" height="36"/>
      <Label id="epLabel" translation="[490,866]" width="920" height="64" vertAlign="center" color="0x9AA4B2FF">
        <Font role="font" uri="font:SystemFontFile" size="26"/>
      </Label>
      <!-- Minha Lista -->
      <Rectangle id="favRing" translation="[1436,862]" width="408" height="72" color="0x9B5DE5FF" opacity="0"/>
      <Rectangle translation="[1440,866]" width="400" height="64" color="0x1C2333FF"/>
      <Label id="favText" translation="[1440,866]" width="400" height="64" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="26"/>
      </Label>
    </Group>

    <!-- Episodes, at the bottom -->
    <RowList id="episodes" translation="[80,962]" itemComponentName="EpButton" numRows="1"
        itemSize="[1760,64]" rowItemSize="[[90,60]]" rowItemSpacing="[[10,0]]" showRowLabel="[false]"
        rowFocusAnimationStyle="floatingFocus" drawFocusFeedback="false"/>

    <!-- Combobox list, opened with OK, grows upwards from the box. -->
    <Group id="seasonPop" visible="false">
      <Rectangle id="popBg" color="0x101626FF"/>
      <LabelList id="seasonList" translation="[12,12]" itemSize="[356,56]"
          color="0xC8D0DCFF" focusedColor="0x0B0F1AFF">
        <Font role="font" uri="font:SystemFontFile" size="26"/>
        <Font role="focusedFont" uri="font:BoldSystemFontFile" size="26"/>
      </LabelList>
    </Group>
  </children>
</component>
