<?xml version="1.0" encoding="utf-8"?>
<!-- Grid view: supports flat items (MarkupGrid) or categorized rows (RowList) with optional search. -->
<component name="GridView" extends="BaseView">
  <interface>
    <field id="section" type="assocarray" onChange="onSection"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/components/utils.brs"/>
  <script type="text/brightscript" uri="pkg:/components/views/GridView.brs"/>
  <children>
    <Poster id="bgGradient" width="1920" height="1080" loadDisplayMode="scaleToFill" visible="false"/>
    <Label id="title" translation="[80,56]" color="0xFFFFFFFF">
      <Font role="font" uri="font:BoldSystemFontFile" size="60"/>
    </Label>
    <Label id="subtitle" translation="[82,136]" color="0x9AA4B2FF">
      <Font role="font" uri="font:SystemFontFile" size="28"/>
    </Label>
    <Label id="status" text="" translation="[80,500]" width="1760" horizAlign="center" color="0xC8D0DCFF" visible="false">
      <Font role="font" uri="font:SystemFontFile" size="34"/>
    </Label>
    <!-- Search bar (shown when section.search = true) -->
    <Group id="searchBar" visible="false" translation="[80,160]">
      <Rectangle id="searchRing" width="1764" height="74" translation="[-2,-2]" color="0x556B2FFF" visible="false"/>
      <Rectangle id="searchBg" width="1760" height="70" color="0xFFFFFFFF"/>
      <Poster id="searchIcon" translation="[20,17]" width="36" height="36" uri="pkg:/images/icon_search.png" blendColor="0x556B2FFF"/>
      <Label id="searchLbl" translation="[66,16]" text="Buscar séries..." color="0x556B2FCC" width="1670">
        <Font role="font" uri="font:SystemFontFile" size="30"/>
      </Label>
    </Group>
    <!-- Dividers container for category separators -->
    <Group id="dividers"/>
    <!-- Flat grid (legacy/fallback) -->
    <MarkupGrid id="grid" translation="[80,250]" itemComponentName="PosterItem"
        numColumns="8" numRows="2" itemSize="[200,370]" itemSpacing="[22,50]"
        vertFocusAnimationStyle="floatingFocus" drawFocusFeedback="false"
        visible="false">
    </MarkupGrid>
    <!-- Category rows (RowList) -->
    <RowList id="rows" translation="[80,250]" itemComponentName="PosterItem"
        numRows="3" itemSize="[1840,370]" itemSpacing="[0,60]"
        rowItemSize="[[200,370]]" rowItemSpacing="[[24,0]]"
        showRowLabel="[true]" rowLabelOffset="[[0,14]]" rowLabelColor="0xFFFFFFFF"
        rowFocusAnimationStyle="floatingFocus" drawFocusFeedback="false" focusXOffset="[0]"
        visible="false">
      <Font role="rowLabelFont" uri="font:BoldSystemFontFile" size="32"/>
    </RowList>
  </children>
</component>
