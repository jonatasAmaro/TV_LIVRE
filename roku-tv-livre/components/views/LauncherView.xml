<?xml version="1.0" encoding="utf-8"?>
<!-- Start screen: wallpaper + carousel at the bottom (gear, TV ao vivo, TV Livre,
     Conexões, installed apps, Central de Apps). Hold OK on a card to move or hide it. -->
<component name="LauncherView" extends="BaseView">
  <script type="text/brightscript" uri="pkg:/components/utils.brs"/>
  <script type="text/brightscript" uri="pkg:/components/views/LauncherView.brs"/>
  <children>
    <Poster id="wallpaper" uri="pkg:/images/launcher_wallpaper.jpg" width="1920" height="1080"/>
    <!-- Fullscreen video behind everything; shown when a live icon is focused. -->
    <Video id="bgVideo" translation="[0,0]" width="1920" height="1080" enableUI="false" visible="false"/>
    <Poster id="shade" uri="pkg:/images/launcher_shade.png" translation="[0,520]" width="1920" height="560"/>
    <!-- Full-width band behind the carousel. -->
    <Rectangle id="menuBand" translation="[0,804]" width="1920" height="276" color="0x000000FF" opacity="0.55"/>

    <Label id="clock" translation="[1560,48]" width="280" horizAlign="right" color="0xFFFFFFFF">
      <Font role="font" uri="font:BoldSystemFontFile" size="64"/>
    </Label>
    <Label id="date" translation="[1240,128]" width="600" horizAlign="right" color="0xDDE3EAFF">
      <Font role="font" uri="font:SystemFontFile" size="28"/>
    </Label>

    <!-- Series preview: informative display when SÉRIES icon is focused -->
    <Group id="seriesPanel" visible="false">
      <!-- Semi-transparent black band: top fixed at 220, stretches down near menu -->
      <Rectangle width="1920" height="560" translation="[0,220]" color="0x000000FF" opacity="0.55"/>
      <!-- Left column: text -->
      <Group id="seriesTextCol" translation="[96,260]">
        <Label id="seriesHeadline" translation="[0,0]" width="1100" color="0xFFFFFFFF" wrap="false">
          <Font role="font" uri="font:BoldSystemFontFile" size="72"/>
        </Label>
        <Label id="seriesDesc" translation="[0,90]" width="900" color="0xC8D0DCFF" wrap="true" maxLines="6">
          <Font role="font" uri="font:SystemFontFile" size="40"/>
        </Label>
      </Group>
      <!-- Right column: fanned poster deck, aligned right -->
      <Group id="seriesDeck" translation="[1380,240]"/>
    </Group>

    <!-- Filmes preview: informative display when FILMES icon is focused -->
    <Group id="moviesPanel" visible="false">
      <Rectangle width="1920" height="560" translation="[0,220]" color="0x000000FF" opacity="0.55"/>
      <Poster id="moviesBg" translation="[0,220]" width="1920" height="560" loadDisplayMode="scaleToFill" opacity="0.7"/>
      <Rectangle width="1920" height="560" translation="[0,220]" color="0x00000088"/>
      <Group id="moviesTextCol" translation="[96,320]">
        <Label id="moviesHeadline" translation="[0,0]" width="1100" color="0xFFFFFFFF" wrap="false">
          <Font role="font" uri="font:BoldSystemFontFile" size="72"/>
        </Label>
        <Label id="moviesDesc" translation="[0,90]" width="900" color="0xC8D0DCFF" wrap="true" maxLines="6">
          <Font role="font" uri="font:SystemFontFile" size="40"/>
        </Label>
      </Group>
    </Group>

    <!-- Animes preview: informative display when ANIMES icon is focused -->
    <Group id="animePanel" visible="false">
      <Rectangle width="1920" height="560" translation="[0,220]" color="0x000000FF" opacity="0.55"/>
      <Group id="animeTextCol" translation="[96,260]">
        <Label id="animeHeadline" translation="[0,0]" width="1100" color="0xFFFFFFFF" wrap="false">
          <Font role="font" uri="font:BoldSystemFontFile" size="72"/>
        </Label>
        <Label id="animeDesc" translation="[0,90]" width="900" color="0xC8D0DCFF" wrap="true" maxLines="6">
          <Font role="font" uri="font:SystemFontFile" size="40"/>
        </Label>
      </Group>
      <Group id="animeDeck" translation="[1380,240]"/>
    </Group>

    <!-- Canais 24h preview: informative display when CANAIS 24 HS icon is focused -->
    <Group id="live24Panel" visible="false">
      <Rectangle width="1920" height="560" translation="[0,220]" color="0x000000FF" opacity="0.55"/>
      <Group id="live24TextCol" translation="[96,280]">
        <Label id="live24Headline" translation="[0,0]" width="1100" color="0xFFFFFFFF" wrap="false">
          <Font role="font" uri="font:BoldSystemFontFile" size="72"/>
        </Label>
        <Label id="live24Desc" translation="[0,90]" width="1400" color="0xC8D0DCFF" wrap="true" maxLines="6">
          <Font role="font" uri="font:SystemFontFile" size="40"/>
        </Label>
      </Group>
    </Group>

    <!-- Conexões: TV inputs, shown above the carousel. -->
    <Group id="inputs" visible="false">
      <Poster uri="pkg:/images/panel.9.png" translation="[60,452]" width="1800" height="290" blendColor="0x0B0F1AFF" opacity="0.82"/>
      <Label text="CONEXÕES" translation="[96,470]" color="0x9AA4B2FF">
        <Font role="font" uri="font:BoldSystemFontFile" size="24"/>
      </Label>
      <Group id="inputRow" translation="[96,514]"/>
    </Group>

    <Label id="title" translation="[96,760]" width="1100" color="0xFFFFFFFF">
      <Font role="font" uri="font:BoldSystemFontFile" size="34"/>
    </Label>
    <Label id="hint" translation="[1120,766]" width="720" horizAlign="right" color="0x9AA4B2FF"
        text="Segure OK para mover ou ocultar">
      <Font role="font" uri="font:SystemFontFile" size="24"/>
    </Label>

    <!-- Gear: opens the Roku home screen, where the TV settings are. -->
    <Group id="gear" translation="[96,880]">
      <Poster id="gearBg" uri="pkg:/images/circle.png" width="104" height="104" blendColor="0x1B2233FF" opacity="0.9"/>
      <Poster id="gearRing" uri="pkg:/images/circle_ring.png" translation="[-8,-8]" width="120" height="120" visible="false"/>
      <Poster uri="pkg:/images/gear.png" translation="[24,24]" width="56" height="56"/>
    </Group>

    <Group id="track" translation="[240,834]"/>

    <!-- Hold-OK menu over the focused card. -->
    <Group id="menu" visible="false">
      <Rectangle id="menuBg" color="0x2A2A2AF2"/>
      <Rectangle id="menuSel" color="0x000000FF"/>
      <Group id="menuItems"/>
    </Group>

    <!-- Move mode: arrows on both sides of the lifted card. -->
    <Group id="moveHint" visible="false">
      <Poster id="arrowLeft" uri="pkg:/images/arrow_left.png" width="48" height="48"/>
      <Poster id="arrowRight" uri="pkg:/images/arrow_right.png" width="48" height="48"/>
    </Group>

    <!-- OSD overlay for fullscreen live mode. -->
    <Group id="liveOsd" visible="false">
      <Rectangle translation="[60,50]" width="900" height="120" color="0x0B0F1ACC"/>
      <Label id="liveOsdName" translation="[90,62]" width="840" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="42"/>
      </Label>
      <Label id="liveOsdInfo" translation="[90,110]" width="840" color="0xC8D0DCFF">
        <Font role="font" uri="font:SystemFontFile" size="26"/>
      </Label>
    </Group>
    <Label id="liveStatus" translation="[0,520]" width="1920" horizAlign="center" wrap="true" color="0xFFFFFFFF" visible="false">
      <Font role="font" uri="font:SystemFontFile" size="30"/>
    </Label>

    <!-- Info bar at bottom (fullscreen live mode) -->
    <Group id="liveInfoBar" visible="false">
      <Rectangle translation="[0,900]" width="1920" height="180" color="0x000000CC"/>
      <Label id="liveInfoNum" translation="[80,912]" width="600" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="48"/>
      </Label>
      <Label id="liveInfoName" translation="[80,968]" width="800" color="0xC8D0DCFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="28"/>
      </Label>
      <Label id="liveInfoEpg" translation="[80,1004]" width="800" color="0x9AA4B2FF">
        <Font role="font" uri="font:SystemFontFile" size="22"/>
      </Label>
      <Label id="liveInfoHint" text="OK  ▸  Abrir grid de canais" translation="[960,972]" width="880" horizAlign="right" color="0x9AA4B2FF">
        <Font role="font" uri="font:SystemFontFile" size="22"/>
      </Label>
    </Group>

    <Timer id="liveZapTimer" duration="0.8"/>
    <Timer id="liveOsdTimer" duration="4"/>
    <Timer id="liveInfoTimer" duration="5"/>

    <Animation id="scrollAnim" duration="0.18" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="scrollInterp" key="[0.0, 1.0]" fieldToInterp="track.translation"/>
    </Animation>

    <Timer id="holdTimer" duration="0.6"/>
    <Timer id="clockTimer" repeat="true" duration="20"/>
  </children>
</component>
