<?xml version="1.0" encoding="utf-8"?>
<!-- Movie details, drawn as a modal over the movie's own poster:
     poster, title, summary and the Assistir button. Back closes it. -->
<component name="MovieDetailView" extends="BaseView">
  <interface>
    <!-- { id, title, poster, url, summary } from the "movies" section of catalog.json -->
    <field id="item" type="assocarray" onChange="onItem"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/components/utils.brs"/>
  <script type="text/brightscript" uri="pkg:/components/views/MovieDetailView.brs"/>
  <children>
    <Rectangle width="1920" height="1080" color="0x0B0F1AFF"/>
    <Poster id="backdrop" width="1920" height="1080" loadDisplayMode="scaleToZoom" opacity="0.18"/>

    <Rectangle translation="[120,110]" width="1680" height="860" color="0x101626FF" opacity="0.92"/>

    <Rectangle translation="[180,170]" width="420" height="630" color="0x1C2333FF"/>
    <Poster id="poster" translation="[180,170]" width="420" height="630" loadDisplayMode="scaleToFit"
        loadingBitmapUri="pkg:/images/placeholder.png" failedBitmapUri="pkg:/images/placeholder.png"/>

    <Label text="FILME" translation="[670,180]" color="0x2EC4B6FF">
      <Font role="font" uri="font:BoldSystemFontFile" size="26"/>
    </Label>
    <Label id="title" translation="[670,222]" width="1070" wrap="true" maxLines="2" color="0xFFFFFFFF">
      <Font role="font" uri="font:BoldSystemFontFile" size="62"/>
    </Label>
    <Label id="summary" translation="[670,400]" width="1070" wrap="true" maxLines="7" lineSpacing="8" color="0xDDE3EAFF">
      <Font role="font" uri="font:SystemFontFile" size="30"/>
    </Label>

    <!-- Buttons: Assistir, or Continuar + Do início when the movie was left halfway.
         The focused one is white with a purple ring. -->
    <Group id="btn0" translation="[670,720]">
      <Rectangle id="ring0" translation="[-6,-6]" width="372" height="92" color="0x9B5DE5FF"/>
      <Rectangle id="bg0" width="360" height="80" color="0xFFFFFFFF"/>
      <Poster id="icon0" uri="pkg:/images/arrow_right.png" translation="[30,20]" width="40" height="40"/>
      <Label id="lbl0" text="Assistir" translation="[78,0]" width="270" height="80" vertAlign="center">
        <Font role="font" uri="font:BoldSystemFontFile" size="32"/>
      </Label>
    </Group>
    <Group id="btn1" translation="[1066,720]" visible="false">
      <Rectangle id="ring1" translation="[-6,-6]" width="292" height="92" color="0x9B5DE5FF"/>
      <Rectangle id="bg1" width="280" height="80" color="0xFFFFFFFF"/>
      <Label id="lbl1" text="Do início" width="280" height="80" horizAlign="center" vertAlign="center">
        <Font role="font" uri="font:BoldSystemFontFile" size="32"/>
      </Label>
    </Group>
    <Label id="status" translation="[670,820]" width="1070" height="50" vertAlign="center" color="0xFFB4A2FF">
      <Font role="font" uri="font:SystemFontFile" size="26"/>
    </Label>

    <Label id="hint" text="OK assiste   |   Voltar fecha" translation="[670,890]" color="0x6C7686FF">
      <Font role="font" uri="font:SystemFontFile" size="24"/>
    </Label>
  </children>
</component>
