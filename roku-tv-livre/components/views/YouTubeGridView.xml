<?xml version="1.0" encoding="utf-8"?>
<component name="YouTubeGridView" extends="BaseView">
  <interface>
    <field id="channels" type="array" onChange="onChannels"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/components/utils.brs"/>
  <script type="text/brightscript" uri="pkg:/components/views/YouTubeGridView.brs"/>
  <children>
    <!-- White background -->
    <Rectangle width="1920" height="1080" color="0xF1F1F1FF"/>

    <!-- Top bar -->
    <Rectangle translation="[0,0]" width="1920" height="56" color="0xFFFFFFFF"/>
    <!-- Hamburger icon -->
    <Rectangle translation="[50,17]" width="24" height="3" color="0x333333FF"/>
    <Rectangle translation="[50,25]" width="24" height="3" color="0x333333FF"/>
    <Rectangle translation="[50,33]" width="24" height="3" color="0x333333FF"/>
    <!-- YouTube logo -->
    <Poster translation="[90,11]" width="180" height="34" uri="pkg:/images/yt_logo.png" loadDisplayMode="scaleToFit"/>

    <!-- Spacer: 2 lines between top bar and content -->

    <!-- Player area (left) -->
    <Rectangle id="ring" translation="[44,82]" width="1052" height="596" color="0xCC0000FF" visible="false"/>
    <Rectangle translation="[50,88]" width="1040" height="584" color="0x0D0D0DFF"/>
    <Video id="video" translation="[50,88]" width="1040" height="584" enableUI="false"/>
    <Poster id="channelArt" translation="[50,88]" width="1040" height="584" loadDisplayMode="scaleToFit" visible="false"/>
    <Label id="status" translation="[50,350]" width="1040" horizAlign="center" wrap="true" color="0x888888FF" visible="false">
      <Font role="font" uri="font:SystemFontFile" size="26"/>
    </Label>

    <!-- Offline message over the preview -->
    <Group id="offlineMsg" visible="false">
      <Rectangle translation="[50,560]" width="1040" height="112" color="0x000000CC"/>
      <Label id="offlineText" translation="[80,560]" width="980" height="112" horizAlign="center" vertAlign="center" wrap="true" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="26"/>
      </Label>
    </Group>

    <!-- Live badge -->
    <Group id="liveBadge" visible="false">
      <Rectangle translation="[62,100]" width="100" height="28" color="0xFF0000FF"/>
      <Label translation="[62,101]" width="100" height="26" text="AO VIVO" horizAlign="center" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="16"/>
      </Label>
    </Group>

    <!-- Info below player -->
    <Label id="chName" translation="[50,686]" width="1040" color="0x0D0D0DFF">
      <Font role="font" uri="font:BoldSystemFontFile" size="26"/>
    </Label>
    <Label id="chInfo" translation="[50,718]" width="1040" color="0x606060FF">
      <Font role="font" uri="font:SystemFontFile" size="20"/>
    </Label>
    <Label id="liveTitle" translation="[50,746]" width="1040" color="0xCC0000FF" wrap="true" maxLines="2" visible="false">
      <Font role="font" uri="font:BoldSystemFontFile" size="18"/>
    </Label>
    <Label id="latestLabel" translation="[50,746]" width="1040" color="0xE07000FF" wrap="true" maxLines="2" visible="false">
      <Font role="font" uri="font:SystemFontFile" size="18"/>
    </Label>
    <Label id="actionHint" translation="[50,786]" width="1040" color="0x808080FF" visible="false">
      <Font role="font" uri="font:SystemFontFile" size="16"/>
    </Label>

    <!-- Channel cards list (right) - single column, scrollable -->
    <MarkupGrid id="grid" translation="[1240,88]"
        numColumns="1" numRows="7"
        itemSize="[600,130]"
        itemSpacing="[0,10]"
        itemComponentName="YTCardItem"
        drawFocusFeedback="false"
        vertFocusAnimationStyle="fixedFocusWrap"/>

    <!-- OSD overlay (fullscreen) -->
    <Group id="osd" visible="false">
      <Rectangle translation="[0,0]" width="1920" height="100" color="0x000000CC"/>
      <Poster translation="[50,10]" width="140" height="28" uri="pkg:/images/yt_logo.png" loadDisplayMode="scaleToFit"/>
      <Label id="osdName" translation="[50,42]" width="1700" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="30"/>
      </Label>
      <Label id="osdInfo" translation="[50,76]" width="1700" color="0xCCCCCCFF">
        <Font role="font" uri="font:SystemFontFile" size="20"/>
      </Label>
    </Group>

    <!-- Redirect alert -->
    <Group id="alert" visible="false">
      <Rectangle width="1920" height="1080" color="0x000000B0"/>
      <Rectangle translation="[440,330]" width="1040" height="420" color="0xFFFFFFFF"/>
      <Rectangle translation="[440,330]" width="1040" height="8" color="0xCC0000FF"/>
      <Label translation="[500,370]" width="920" text="CANAL OFFLINE" color="0xCC0000FF">
        <Font role="font" uri="font:BoldSystemFontFile" size="30"/>
      </Label>
      <Label id="alertText" translation="[500,425]" width="920" wrap="true" color="0x0D0D0DFF">
        <Font role="font" uri="font:SystemFontFile" size="26"/>
      </Label>
      <Rectangle id="btnRedirBg" translation="[500,640]" width="430" height="70" color="0xCC0000FF"/>
      <Label id="btnRedir" translation="[500,640]" width="430" height="70" text="REDIRECIONAR" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="26"/>
      </Label>
      <Rectangle id="btnCancelBg" translation="[990,640]" width="430" height="70" color="0xE5E5E5FF"/>
      <Label id="btnCancel" translation="[990,640]" width="430" height="70" text="CANCELAR" horizAlign="center" vertAlign="center" color="0x0D0D0DFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="26"/>
      </Label>
    </Group>

    <Timer id="osdTimer" duration="4"/>
  </children>
</component>
